    <mxCell id="title" value="IR beam wiring — examples/04_test_ir_blink.py (block the beam → onboard LED blinks)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="15" width="760" height="30" as="geometry" />
