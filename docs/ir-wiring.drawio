    <mxCell id="w3" value="cathode" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.9;entryY=0;fontSize=10;" edge="1" parent="1" source="irled" target="gndrail"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="w4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3v3" target="r10k"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="w5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r10k" target="pdio"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="w6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pgp6" target="pdio"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="w7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.55;entryY=0;" edge="1" parent="1" source="pdio" target="gndrail"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="w8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pgnd" target="gndrail"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="note" value="Using a 3-pin receiver MODULE instead of a bare part?&#10;   VCC → 3V3,  GND → GND,  OUT → GP6 directly — no 10 kΩ needed.&#10;&#10;• Emitter and receiver physically face each other across the bin opening;&#10;   the dashed arrow is the light path, not a wire.&#10;• Blocked beam → onboard LED blinks at 5 Hz (run examples/04_test_ir_blink.py).&#10;• IR light is invisible — a phone camera shows the emitter as a purple glow.&#10;• Beam-seen polarity wrong? Flip IR_BEAM_SEEN_VALUE in config.py." style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="640" y="80" width="330" height="220" as="geometry" />
    </mxCell>
  </root>
</mxGraphModel>
