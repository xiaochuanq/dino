    <mxCell id="r10k" value="10 kΩ pull-up&#10;(skip if 3-pin module)" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="340" y="300" width="100" height="36" as="geometry" />
