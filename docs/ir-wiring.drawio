      <mxGeometry x="350" y="220" width="80" height="30" as="geometry" />
    </mxCell>
    <mxCell id="irled" value="IR emitter LED — 940 nm, 5 mm&#10;(anode / long leg to resistor)" style="verticalLabelPosition=bottom;shadow=0;dashed=0;align=center;html=1;verticalAlign=top;shape=mxgraph.electrical.opto_electronics.led_1;pointerEvents=1;strokeColor=#990000;fontColor=#990000;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="490" y="200" width="100" height="62" as="geometry" />
    </mxCell>
    <mxCell id="beam" value="invisible IR beam across the bin&#10;(emitter faces receiver)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#cc0000;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#cc0000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="irled" target="pdio">
      <mxGeometry relative="1" as="geometry" />
